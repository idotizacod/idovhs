{
  "$description": "Idotiza — design tokens compartidos (DIY / fanzine / post-punk / digital 2000)",
  "color": {
    "blanco": { "$type": "color", "$value": "#f5f5f5" },
    "negro": { "$type": "color", "$value": "#000000" },
    "rojo": { "$type": "color", "$value": "#ff1e00" },
    "celeste": { "$type": "color", "$value": "#62f2f6" }
  },
  "semantic": {
    "background": { "$type": "color", "$value": "{color.blanco}" },
    "surface": { "$type": "color", "$value": "#fbfbf8" },
    "text": { "$type": "color", "$value": "{color.negro}" },
    "muted": { "$type": "color", "$value": "#4a4a4a" },
    "accent": { "$type": "color", "$value": "{color.rojo}" },
    "filter": { "$type": "color", "$value": "{color.celeste}" }
  },
  "font": {
    "typewriter": { "$type": "fontFamily", "$value": "Special Elite" },
    "hand": { "$type": "fontFamily", "$value": "Special Elite" },
    "technical": { "$type": "fontFamily", "$value": "Special Elite" }
  },
  "icon": {
    "logo": { "$type": "file", "$value": "brand/logo.png" },
    "sockLegacy": { "$type": "file", "$value": "brand/sock.svg" }
  },
  "grade": {
    "shadow": { "$type": "color", "$value": "{color.negro}" },
    "mid": { "$type": "color", "$value": "{color.celeste}" },
    "highlight": { "$type": "color", "$value": "{color.blanco}" }
  }
}
